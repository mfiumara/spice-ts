{
  "name": "@spice-ts/mcp",
  "version": "0.3.0",
  "description": "Bounded MCP server for the spice-ts protocol v1 adapter",
  "license": "MIT",
  "author": "Mattia Fiumara",
  "repository": {
    "type": "git",
    "url": "https://github.com/mfiumara/spice-ts.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "spice-ts-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "scripts": {
    "prebuild": "pnpm -C ../core build && pnpm -C ../protocol build",
    "build": "tsup",
    "pretest": "pnpm -C ../core build && pnpm -C ../protocol build",
    "test": "vitest run && pnpm test:packed-consumer",
    "pretest:coverage": "pnpm -C ../core build && pnpm -C ../protocol build",
    "test:coverage": "vitest run && pnpm test:packed-consumer",
    "test:packed-consumer": "pnpm build && node scripts/packed-consumer.mjs",
    "prelint": "pnpm -C ../core build && pnpm -C ../protocol build",
    "lint": "tsc --noEmit",
    "example": "pnpm build && node examples/agent.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@spice-ts/core": "workspace:*",
    "@spice-ts/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
