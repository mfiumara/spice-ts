{
  "name": "@spice-ts/wasm",
  "private": true,
  "version": "0.3.0",
  "description": "Protocol-v1 module-worker facade for spice-ts",
  "license": "MIT",
  "author": "Mattia Fiumara",
  "repository": {
    "type": "git",
    "url": "https://github.com/mfiumara/spice-ts.git",
    "directory": "packages/wasm"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": "./dist/manifest.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "pretest": "pnpm build",
    "test": "vitest run && pnpm test:packed-consumer",
    "test:packed-consumer": "pnpm build && node scripts/packed-consumer.mjs",
    "bench:ac": "pnpm build && tsx scripts/ac-accuracy.ts",
    "bench:dc": "pnpm build && tsx ../../benchmarks/wasm-dc-sweep/compare.ts",
    "pretest:coverage": "pnpm -C ../core build && pnpm -C ../protocol build",
    "test:coverage": "pnpm build && vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@spice-ts/core": "workspace:*",
    "@spice-ts/protocol": "workspace:*",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.4",
    "tsx": "^4.21.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "ws": "^8.22.0"
  }
}
