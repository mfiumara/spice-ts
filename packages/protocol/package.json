{
  "name": "@spice-ts/protocol",
  "version": "0.3.0",
  "description": "Environment-neutral wire protocol for spice-ts",
  "license": "MIT",
  "author": "Mattia Fiumara",
  "repository": {
    "type": "git",
    "url": "https://github.com/mfiumara/spice-ts.git",
    "directory": "packages/protocol"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "schemas",
    "fixtures"
  ],
  "scripts": {
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
