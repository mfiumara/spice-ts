@@ -0,0 +1,35 @@
+import { describe, expect, it, vi } from 'vitest';
+
+const loaded = vi.hoisted(() => ({ count: 0 }));
+vi.mock('./simulate.js', async (original) => {
+  loaded.count++;
+  return original();
+});
+
+import { createSimulator, simulate, simulateStream, simulateStepStream } from './index.js';
+
+const netlist = 'lazy entry\nV1 in 0 1\nR1 in 0 1k\n.op\n.end';
+
+describe('lazy public simulation entry', () => {
+  it('defers the analysis engine through synchronous factory construction', async () => {
+    expect(loaded.count).toBe(0);
+    const backend = createSimulator();
+    expect(backend.name).toBe('spice-ts');
+    expect(loaded.count).toBe(0);
+    const result = await backend.simulate(netlist);
+    expect(result.dc?.voltage('in')).toBe(1);
+    expect(loaded.count).toBe(1);
+    expect((await simulate(netlist)).dc?.voltage('in')).toBe(1);
+  });
+
+  it('forwards async stream results and errors', async () => {
+    const deck = 'stream\nV1 in 0 1\nR1 in out 1k\nC1 out 0 1n\n.tran 1n 10n\n.end';
+    const points = [];
+    for await (const point of simulateStream(deck)) points.push(point);
+    expect(points.length).toBeGreaterThan(1);
+    const events = [];
+    for await (const event of simulateStepStream(deck)) events.push(event);
+    expect(events.length).toBe(points.length);
+    await expect(simulate('invalid\nR1 a 0 unknown\n.op')).rejects.toMatchObject({ name: 'InvalidCircuitError' });
+  });
+});
