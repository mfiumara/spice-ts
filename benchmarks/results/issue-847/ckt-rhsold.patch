+/**
+ * ngspice-47 reports the iterate the converging solve was linearised at, not
+ * that solve (#847): NIiter (maths/ni/niiter.c) returns on convergence before
+ * its trailing `SWAP(CKTrhs, CKTrhsOld)`, and CKTdump (cktdump.c), the
+ * operating point handed to AC/noise (dcop.c, dctran.c `CKTrhsOp`), and the
+ * next sweep point or timestep all read `CKTrhsOld`. The device state of the
+ * accepted point (CKTstate0) was evaluated at that same iterate. NIiter never
+ * converges on its first iteration (`iterno != 1`); when spice-ts accepts the
+ * first solve, ngspice would iterate once more and its CKTrhsOld would be that
+ * same first solve, so it is kept.
+ */
+export function acceptLinearisationPoint(
+  solution: Float64Array, linearisationPoint: Float64Array, iter: number,
+): void {
+  if (iter > 0) solution.set(linearisationPoint);
+}
