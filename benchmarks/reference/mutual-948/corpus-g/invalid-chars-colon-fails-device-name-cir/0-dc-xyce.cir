.DC V1 1 1 1
V1 1 0 1
r1 1 0 1

* both of these instance lines will fail.  Just 
* testing one of them for now.
v2: 2 0 1
*v:  3 0 1

.print DC format=csv file=output.csv precision=17 {V1} I(v1) I(v2:) V(1) V(2)
.end
