{
  "name": "spice-ts",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test && tsx --test benchmarks/comparison-harness.test.ts",
    "lint": "pnpm -r lint",
    "bench": "pnpm -C packages/core bench",
    "bench:scaling": "cd packages/core && pnpm build && cd ../.. && tsx benchmarks/performance/scaling.ts",
    "bench:accuracy": "cd packages/core && pnpm build && cd ../.. && npx tsx benchmarks/accuracy.ts",
    "bench:current-source-ac": "pnpm -C packages/core build && tsx benchmarks/current-source-ac/compare.ts",
    "bench:current-source-polarity": "pnpm -C packages/core build && tsx benchmarks/current-source-polarity/compare.ts",
    "bench:stepped-tf": "pnpm -C packages/core build && tsx benchmarks/stepped-transfer-function/compare.ts",
    "bench:temp-step": "pnpm -C packages/core build && tsx benchmarks/temp-step-resistor/compare.ts",
    "bench:disto": "pnpm -C packages/core build && tsx benchmarks/distortion/compare.ts",
    "bench:differential-noise": "pnpm -C packages/core build && tsx benchmarks/differential-noise/compare.ts",
    "bench:compare": "cd packages/core && pnpm build && cd ../.. && npx tsx benchmarks/comparison.ts",
    "bench:compare:v2": "pnpm -C packages/core build && tsx benchmarks/comparison-harness.ts",
    "bench:convergence": "cd packages/core && pnpm build && cd ../.. && npx tsx benchmarks/convergence.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.5.2",
    "eecircuit-engine": "^1.7.0",
    "tsx": "^4.21.0"
  }
}
